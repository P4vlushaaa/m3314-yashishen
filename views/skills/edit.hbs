<!DOCTYPE html>
<html lang="ru">
<head>
    <title>Редактировать навык</title>
    {{> head}}
</head>
<body>
{{> header}}

{{#> content}}
    <section>
        <h1>Редактировать навык</h1>

        <form action="/skills/{{skill.id}}/edit" method="post" class="constructor-form">
            <label>
                Название
                <input type="text" name="title" value="{{skill.title}}" required>
            </label>

            <label>
                Описание
                <textarea name="description" rows="6" required>{{skill.description}}</textarea>
            </label>

            <label>
                Ссылка на изображение
                <input type="text" name="imageUrl" id="skill-image-url" value="{{skill.imageUrl}}">
            </label>

            <div
                    class="upload-control"
                    data-image-upload
                    data-upload-endpoint="/api/skills/upload"
                    data-upload-target="#skill-image-url"
            >
                <input
                        type="file"
                        id="skill-image-file"
                        accept="image/png,image/jpeg,image/jpg,image/webp"
                        hidden
                >
                <button type="button" class="white-button" data-upload-trigger>
                    Загрузить изображение
                </button>
                <span class="upload-control__status" data-upload-status></span>
            </div>

            <button type="submit" class="black-button">Сохранить изменения</button>
        </form>
    </section>
{{/content}}

{{> footer}}
<script src="/js/project-image-upload.js" defer></script>
</body>
</html>

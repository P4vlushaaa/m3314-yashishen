<!DOCTYPE html>
<html lang="ru">
<head>
    <title>{{skill.title}}</title>
    {{> head}}
</head>
<body>
{{> header}}

{{#> content}}
    <section>
        <h1>{{skill.title}}</h1>

        {{#if skill.imageUrl}}
            <article>
                <img src="{{skill.imageUrl}}" alt="{{skill.title}}" width="250">
            </article>
        {{/if}}

        <article>
            <h3>Описание</h3>
            <p>{{skill.description}}</p>
        </article>

        <aside class="about-button">
            <a href="/skills" class="white-button">Назад к списку</a>
            <a href="/skills/{{skill.id}}/edit" class="black-button">Редактировать</a>
        </aside>
    </section>
{{/content}}

{{> footer}}
</body>
</html>
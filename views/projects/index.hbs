{{#> layout pageTitle="Проекты"}}

{{#> content}}
<section>
    <h1>Проекты</h1>

    <aside class="project__row">
        {{#each projects}}
            <div class="project-item">
                {{> projectCard}}

                <div class="project-actions">
                    <div class="project-actions-left">
                        <a href="/projects/{{id}}" class="white-button">
                            Открыть
                        </a>

                        <a href="/projects/{{id}}/edit" class="black-button">
                            Редактировать
                        </a>
                    </div>

                    <form action="/projects/{{id}}/delete" method="post">
                        <button type="submit" class="danger-button">
                            Удалить
                        </button>
                    </form>
                </div>
            </div>
        {{/each}}
    </aside>

    <aside style="display:flex; justify-content:center; margin-top:24px;">
        <a href="/projects/add" class="black-button">
            Добавить проект
        </a>
    </aside>
</section>
{{/content}}

<script>
document.addEventListener('DOMContentLoaded', () => {
    const eventSource = new EventSource('/projects/events');

    eventSource.onmessage = (event) => {
        try {
            const payload = JSON.parse(event.data);

            if (payload?.message) {
                showToast(payload.message, 'info');
            }
        } catch (error) {
            console.error('SSE parse error:', error);
        }
    };

    eventSource.onerror = (error) => {
        console.error('SSE connection error:', error);
    };
});
</script>

{{/layout}}